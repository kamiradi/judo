<mujoco model="peg_insertion_twist">
  <!-- Twist-controlled peg insertion: there is NO robot arm. The arch peg is mounted -->
  <!-- on a 6-DOF Cartesian carriage (3 slide + 3 hinge joints) driven by VELOCITY     -->
  <!-- actuators, so the control input is the peg's end-effector twist                  -->
  <!-- [vx, vy, vz, wx, wy, wz] (world-frame linear + angular velocity). The arch hole  -->
  <!-- sits at the same known, fixed pose as in peg_insertion.xml.                       -->
  <compiler angle="radian" autolimits="true"/>
  <!-- gravity off: the peg is a kinematically twist-commanded end-effector, not a -->
  <!-- dynamically supported body, so we don't want it to sag under the servos.    -->
  <option integrator="implicitfast" timestep="0.004" impratio="10.0" gravity="0 0 0"/>

  <default>
    <!-- velocity-servo defaults for the 6 Cartesian DOFs: force = kv * (ctrl - qvel) -->
    <default class="eef_lin">
      <joint damping="1.0"/>
      <velocity kv="200" ctrlrange="-0.01 0.01"/>
    </default>
    <default class="eef_ang">
      <joint damping="1.0"/>
      <velocity kv="50" ctrlrange="-1.0 1.0"/>
    </default>
  </default>

  <!-- No <asset> block: all peg AND hole meshes (visual + convex collision pieces) are -->
  <!-- added in the task's _process_spec, since the shape (arch / rectangle / ...) is    -->
  <!-- chosen at task build time.                                                         -->

  <worldbody>
    <!-- work surface -->
    <body name="table">
      <geom name="table" type="box" size="0.75 1.25 0.01" pos="0.5 0 -0.01" rgba="0.8 0.8 0.8 1"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Movable mount: the hole hangs off a 4-DOF carriage (x / y / z slide + yaw      -->
    <!-- hinge) whose origin is the hole axis at z=0.2, so its pose can be changed at    -->
    <!-- runtime. The body is heavy and the joints are strongly damped, and gravity is  -->
    <!-- off, so it holds whatever pose is commanded. The task writes the GUI slider     -->
    <!-- values (or, in the ROS bridge, the insertion_goal TF) into these joints' qpos;  -->
    <!-- because the joints are part of the state, the planner's rollouts (seeded from   -->
    <!-- the current state) track the moved hole automatically -- no actuators are added -->
    <!-- (nu stays 6), the carriage is driven purely kinematically.                      -->
    <body name="hole_base" pos="0.5 0 0.2">
      <inertial pos="0 0 0" mass="10000" diaginertia="1000 1000 1000"/>
      <joint name="hole_tx" type="slide" axis="1 0 0" damping="100000"/>
      <joint name="hole_ty" type="slide" axis="0 1 0" damping="100000"/>
      <joint name="hole_tz" type="slide" axis="0 0 1" damping="100000"/>
      <joint name="hole_yaw" type="hinge" axis="0 0 1" damping="100000"/>

      <!-- HOLE (opening up, +z). At hole_base origin, so it sits at world (0.5,0,0.2)  -->
      <!-- when the carriage joints are zero. The visual mesh and convex collision      -->
      <!-- pieces (arch / rectangle / ...) are added to this body in the task's          -->
      <!-- _process_spec.                                                                -->
      <body name="hole" pos="0 0 0" quat="1 0 0 0">
        <!-- reward targets, rigidly attached -> encode the (now movable) hole pose -->
        <site name="hole_entrance" pos="0 0 0.05"  size="0.004" rgba="0 1 0 0.7"/>
        <site name="hole_bottom"   pos="0 0 0.006" size="0.004" rgba="1 0 0 0.7"/>
        <geom name="hole_bottom_marker" type="sphere" size="0.01" pos="0 0 0.006"
              contype="0" conaffinity="0" rgba="0 1 0 1"/>
        <geom name="hole_axis_x" type="cylinder" fromto="0 0 0.006 0.06 0 0.006" size="0.0035"
              contype="0" conaffinity="0" rgba="1 0 0 1"/>
        <geom name="hole_axis_y" type="cylinder" fromto="0 0 0.006 0 0.06 0.006" size="0.0035"
              contype="0" conaffinity="0" rgba="0 1 0 1"/>
        <geom name="hole_axis_z" type="cylinder" fromto="0 0 0.006 0 0 0.066" size="0.0035"
              contype="0" conaffinity="0" rgba="0 0 1 1"/>
      </body>
    </body>

    <!-- 6-DOF Cartesian carriage that carries the peg. At qpos=0 the carriage frame  -->
    <!-- is world-aligned at (0.5, 0, 0.45); the peg (attached to "eef" in the task's  -->
    <!-- _process_spec) hangs straight down with its tip at world (0.5, 0, 0.30),      -->
    <!-- hovering just above the hole entrance. The slide axes give world-frame linear -->
    <!-- velocity; the hinge axes give (approximately) world-frame angular velocity.   -->
    <body name="eef_x" pos="0.5 0 0.45">
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
      <joint name="eef_tx" type="slide" axis="1 0 0" class="eef_lin"/>
      <body name="eef_y">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <joint name="eef_ty" type="slide" axis="0 1 0" class="eef_lin"/>
        <body name="eef_z">
          <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
          <joint name="eef_tz" type="slide" axis="0 0 1" class="eef_lin"/>
          <body name="eef_rx">
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
            <joint name="eef_wx" type="hinge" axis="1 0 0" class="eef_ang"/>
            <body name="eef_ry">
              <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
              <joint name="eef_wy" type="hinge" axis="0 1 0" class="eef_ang"/>
              <body name="eef">
                <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
                <joint name="eef_wz" type="hinge" axis="0 0 1" class="eef_ang"/>
                <!-- the arch peg is attached here in the task's _process_spec hook -->
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- control = end-effector twist [vx, vy, vz, wx, wy, wz] -->
    <velocity name="vx" joint="eef_tx" class="eef_lin"/>
    <velocity name="vy" joint="eef_ty" class="eef_lin"/>
    <velocity name="vz" joint="eef_tz" class="eef_lin"/>
    <velocity name="wx" joint="eef_wx" class="eef_ang"/>
    <velocity name="wy" joint="eef_wy" class="eef_ang"/>
    <velocity name="wz" joint="eef_wz" class="eef_ang"/>
  </actuator>
</mujoco>
